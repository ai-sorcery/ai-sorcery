# llm-routing — provider API keys.
#
# Copy this file to .env at the same location and fill in the keys for
# whichever providers you want to use. .env is sourced by ./llm.sh and
# ./llm-routing/route.sh before they invoke litellm, so the proxy reads
# the values at startup without any per-shell exports.
#
# You don't need every key. LiteLLM only fails when a request targets a
# model whose key is missing — keep the lines you have, delete the rest
# (or leave them empty).

# Hugging Face Inference Providers — one token brokers access to many
# open-weight upstream providers (Together, Fireworks, Replicate, etc).
# https://huggingface.co/settings/tokens
HF_TOKEN=

# DeepSeek (first-party) — default frontier tier (deepseek-v4-pro) plus
# deepseek-chat / deepseek-reasoner.
# https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Moonshot AI — default balanced tier (kimi-k2).
# https://platform.moonshot.ai/console/api-keys
MOONSHOT_API_KEY=

# MiniMax — routes via the openai/ prefix with api_base override.
# https://www.minimax.io/platform/user-center/basic-information/interface-key
MINIMAX_API_KEY=

# Anthropic (Claude) — used by the `claude` tier (Opus 1M → Sonnet → Haiku).
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# OpenAI — used by direct model_name aliases (gpt-5, gpt-5-mini, gpt-4.1-mini).
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
